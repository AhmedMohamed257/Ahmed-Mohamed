<section class="hiring-grid">

  <div class="page-width">

    <div class="hg-header">
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="hg-products">

      {% for block in section.blocks %}
      <div class="hg-card" {{ block.shopify_attributes }}>

        <div class="hg-image">

          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 700 }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}">
          {% endif %}

          <button
              class="hg-plus"
              type="button"
              data-popup="popup-{{ block.id }}"
              aria-label="Quick view {{ block.settings.title }}"
          >

              <img
                  src="{{ 'plus-icon.svg' | asset_url }}"
                  alt=""
                  width="42"
                  height="42"
            >

          </button>

        </div>

      </div>

      <!-- Popup -->

      <div class="hg-popup" id="popup-{{ block.id }}">

        <div class="hg-popup-overlay"></div>

        <div class="hg-popup-box">

          <button class="hg-close" type="button" aria-label="Close">&times;</button>

          <div class="hg-popup-image">

            {% if block.settings.popup_image %}
              <img
              src="{{ block.settings.popup_image | image_url: width: 300 }}"
              width="120"
              height="140"
              alt="{{ block.settings.title }}">
            {% endif %}

          </div>

          <h3 class="hg-popup-title">{{ block.settings.title }}</h3>

          <p class="hg-popup-price">{{ block.settings.price }}</p>

          <div class="hg-popup-description">
            {{ block.settings.description }}
          </div>

          <div class="hg-popup-color-section">

            <span class="hg-popup-field-label">Color</span>

            <div class="hg-colors">

              <div class="hg-color-item">
                <svg class="hg-color-swatch" width="5" height="40" viewBox="0 0 5 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0.25" y="0.25" width="4.33929" height="39.1325" fill="{{ block.settings.color1_swatch }}" stroke="{{ block.settings.color1_swatch }}" stroke-width="0.5"/>
                </svg>
                <button type="button" class="hg-color-btn is-selected" data-color="{{ block.settings.color1 | escape }}">
                  <span class="hg-color-label">{{ block.settings.color1 }}</span>
                </button>
              </div>

              <div class="hg-color-item">
                <svg class="hg-color-swatch" width="5" height="40" viewBox="0 0 5 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0.25" y="0.25" width="4.33929" height="39.1325" fill="{{ block.settings.color2_swatch }}" stroke="{{ block.settings.color2_swatch }}" stroke-width="0.5"/>
                </svg>
                <button type="button" class="hg-color-btn" data-color="{{ block.settings.color2 | escape }}">
                  <span class="hg-color-label">{{ block.settings.color2 }}</span>
                </button>
              </div>

            </div>

          </div>

          <div class="hg-popup-size-section">

            <span class="hg-popup-field-label">Size</span>

            <div class="hg-select-wrap">

              <select class="hg-select">

                <option value="">{{ block.settings.size_placeholder }}</option>

                <option value="S">S</option>

                <option value="M">M</option>

                <option value="L">L</option>

                <option value="XL">XL</option>

              </select>

            </div>

          </div>

          <a href="{{ block.settings.button_link }}" class="hg-popup-cta">

            <span>{{ block.settings.button_text }}</span>

            <img src="{{ 'icon-arrow.svg' | asset_url }}" alt="">

          </a>

        </div>

      </div>

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name":"Hiring Grid",
  "tag":"section",
  "class":"section-hiring-grid",

  "settings":[

    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Tisso vision in the wild"
    }

  ],

  "blocks":[

    {
      "type":"product",

      "name":"Product",

      "settings":[

        {
          "type":"image_picker",
          "id":"image",
          "label":"Grid Image"
        },

        {
          "type":"image_picker",
          "id":"popup_image",
          "label":"Popup Image"
        },

        {
          "type":"text",
          "id":"title",
          "label":"Title",
          "default":"Orange Wide Leg"
        },

        {
          "type":"text",
          "id":"price",
          "label":"Price",
          "default":"980,00€"
        },

        {
          "type":"richtext",
          "id":"description",
          "label":"Description",
          "default":"<p>This one-piece swimsuit is crafted from jersey featuring an allover micro Monogram motif in relief.</p>"
        },

        {
          "type":"text",
          "id":"color1",
          "label":"First Color Label",
          "default":"White"
        },

        {
          "type":"color",
          "id":"color1_swatch",
          "label":"First Color Swatch",
          "default":"#FFFFFF"
        },

        {
          "type":"text",
          "id":"color2",
          "label":"Second Color Label",
          "default":"Black"
        },

        {
          "type":"color",
          "id":"color2_swatch",
          "label":"Second Color Swatch",
          "default":"#000000"
        },

        {
          "type":"text",
          "id":"size_placeholder",
          "label":"Size Placeholder",
          "default":"Choose your size"
        },

        {
          "type":"text",
          "id":"button_text",
          "label":"Button",
          "default":"ADD TO CART"
        },

        {
          "type":"url",
          "id":"button_link",
          "label":"Button Link"
        }

      ]

    }

  ],

  "max_blocks":6,

  "presets":[
    {
      "name":"Hiring Grid"
    }
  ]

}
{% endschema %}
