<section class="hiring-grid">

  <div class="page-width">

    <div class="hg-header">
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="hg-products">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product == blank %}
          {% continue %}
        {% endif %}

        <div class="hg-card" {{ block.shopify_attributes }}>

          <div class="hg-image">

            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 700 }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}">
            {% endif %}

            <button
                class="hg-plus"
                type="button"
                data-popup="popup-{{ block.id }}"
                aria-label="Quick view {{ product.title | escape }}"
            >
              <img src="{{ 'plus-icon.svg' | asset_url }}" alt="" width="42" height="42">
            </button>

          </div>

        </div>

        <!-- Popup -->
        <div class="hg-popup" id="popup-{{ block.id }}">

          <div class="hg-popup-overlay"></div>

          <div class="hg-popup-box">

            <button class="hg-close" type="button" aria-label="Close">&times;</button>

            <div class="hg-popup-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  width="120"
                  height="140"
                  alt="{{ product.title | escape }}">
              {% endif %}
            </div>

            <h3 class="hg-popup-title">{{ product.title }}</h3>

            <p class="hg-popup-price" data-price>{{ product.selected_or_first_available_variant.price | money }}</p>

            <div class="hg-popup-description">
              {{ product.description }}
            </div>

            <product-quickview
              class="hg-quickview"
              data-auto-add-variant-id="{{ section.settings.auto_add_product.selected_or_first_available_variant.id }}"
            >

              <form data-quickview-form>

                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index -%}

                  <div class="hg-popup-option-section" data-option-index="{{ option_index }}">

                    <span class="hg-popup-field-label">{{ option.name }}</span>

                    {%- if option.name == "Color" or option.name == "Colour" -%}

                      <div class="hg-colors" data-option-position="{{ option_index }}">
                        {%- for value in option.values -%}
                          <div class="hg-color-item">
                            <svg class="hg-color-swatch" width="5" height="40" viewBox="0 0 5 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                              <rect x="0" y="0" width="5" height="40" fill="{{ value | handleize }}"/>
                            </svg>
                            <button
                              type="button"
                              class="hg-color-btn{% if forloop.first %} is-selected{% endif %}"
                              data-value="{{ value | escape }}"
                              data-option-position="{{ option_index }}"
                            >
                              <span class="hg-color-label">{{ value }}</span>
                            </button>
                          </div>
                        {%- endfor -%}
                      </div>

                    {%- else -%}

                      <div class="hg-select-wrap">
                        <select class="hg-select" data-option-position="{{ option_index }}">
                          {%- for value in option.values -%}
                            <option value="{{ value | escape }}"{% if forloop.first %} selected{% endif %}>{{ value }}</option>
                          {%- endfor -%}
                        </select>
                      </div>

                    {%- endif -%}

                  </div>

                {%- endfor -%}

                <input type="hidden" name="id" data-variant-id value="{{ product.selected_or_first_available_variant.id }}">

                <button type="submit" class="hg-popup-cta" data-add-to-cart>
                  <span data-cta-label>{{ 'ADD TO CART' }}</span>
                  <img src="{{ 'icon-arrow.svg' | asset_url }}" alt="">
                </button>

                <p class="hg-popup-status" data-status role="status" aria-live="polite"></p>

              </form>

              <script type="application/json" data-product-json>
                {{ product.variants | json }}
              </script>

            </product-quickview>

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name":"Hiring Grid",
  "tag":"section",
  "class":"section-hiring-grid",

  "settings":[
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Tisso vision in the wild"
    },
    {
      "type":"product",
      "id":"auto_add_product",
      "label":"Auto-add product",
      "info":"Added automatically when a customer's chosen variant includes both Black and Medium options."
    }
  ],

  "blocks":[
    {
      "type":"product",
      "name":"Product",
      "settings":[
        {
          "type":"product",
          "id":"product",
          "label":"Product"
        }
      ]
    }
  ],

  "max_blocks":6,

  "presets":[
    { "name":"Hiring Grid" }
  ]
}
{% endschema %}