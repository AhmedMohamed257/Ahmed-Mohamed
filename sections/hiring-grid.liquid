<section class="hiring-grid">

  <div class="page-width">

    <div class="hg-header">
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="hg-products">

      {% if section.settings.collection != blank %}

        {% for product in section.settings.collection.products limit: 6 %}

          <div class="hg-card">

            <a href="{{ product.url }}" class="hg-image">

              {% if product.featured_image %}

                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="450"
                  height="560"
                >

              {% endif %}

            </a>

            <div class="hg-info">

              <h3 class="hg-title">
                {{ product.title }}
              </h3>

              <p class="hg-price">
                {{ product.price | money }}
              </p>

            </div>

          </div>

        {% endfor %}

      {% else %}

        <p>Please select a collection.</p>

      {% endif %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Hiring Grid",
  "tag": "section",
  "class": "section-hiring-grid",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }

  ],

  "presets": [
    {
      "name": "Hiring Grid"
    }
  ]
}
{% endschema %}