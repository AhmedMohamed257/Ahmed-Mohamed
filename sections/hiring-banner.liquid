{{ 'hiring.css' | asset_url | stylesheet_tag }}
{{ 'hiring.js' | asset_url | script_tag }}

<section class="hiring-banner">

  <!-- Header -->
  <div class="banner-header page-width">

    <div class="banner-logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="banner-message">
      {{ section.settings.header_text }}
    </div>

    <a
      href="{{ section.settings.header_button_link }}"
      class="banner-header-btn"
      aria-label="{{ section.settings.header_button }}"
    >
      {{ section.settings.header_button }}
    </a>

  </div>

  <!-- Top Illustration -->
  <div class="banner-top-svg">
    <img
      src="{{ 'banner-top.svg' | asset_url }}"
      alt="Gift Guide Top Artwork"
      class="banner-top-artwork"
      loading="lazy"
    >
  </div>

  <!-- Bottom Section -->
  <div class="banner-bottom page-width">

    <!-- Left Content -->
    <div class="banner-left">

      <h1 class="banner-title">
        {{ section.settings.heading }}
      </h1>

      <div class="banner-description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link }}"
        class="banner-btn"
        aria-label="{{ section.settings.button_text }}"
      >
        {{ section.settings.button_text }}
      </a>

    </div>

    <!-- Right Illustration -->
    <div class="banner-right">

      <img
        src="{{ 'banner-bottom.svg' | asset_url }}"
        alt="Gift Guide Bottom Artwork"
        class="banner-artwork"
        loading="lazy"
      >

    </div>

  </div>

  <!-- Footer -->
  <div class="banner-footer">

    {{ section.settings.footer_text }}

  </div>

</section>

{% schema %}
{
  "name": "Hiring Banner",
  "tag": "section",
  "class": "section-hiring-banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button",
      "label": "Header Button",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Header Button Link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Hiring Banner"
    }
  ]
}
{% endschema %}