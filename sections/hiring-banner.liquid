{{ 'hiring.css' | asset_url | stylesheet_tag }}
{{ 'hiring.js' | asset_url | script_tag }}



<section class="hiring-banner" id="hiring-banner-{{ section.id }}">

  <!-- 1. Top bar -->
  <div class="hb-topbar">
    <div class="hb-topbar__inner">

      <button
        type="button"
        class="hb-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="hb-mobile-menu-{{ section.id }}"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <p class="hb-logo">{{ section.settings.logo_text }}</p>

      <p class="hb-topbar__message">{{ section.settings.header_text }}</p>

      {%- if section.settings.header_button_text != blank -%}
        <a
          {% if section.settings.header_button_link != blank %}
            href="{{ section.settings.header_button_link }}"
          {% else %}
            href="#" role="link" aria-disabled="true"
          {% endif %}
          class="hb-btn hb-btn--yellow"
        >
          <span class="hb-btn__fill" aria-hidden="true"></span>
          <span class="hb-btn__label">{{ section.settings.header_button_text }}</span>
          <span class="hb-btn__arrow" aria-hidden="true">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </a>
      {%- endif -%}

    </div>
  </div>

  <!-- 2. Hero -->
<div class="hb-hero">

  <!-- Top artwork -->
  <div class="hb-hero__top">
    <img
      src="{{ 'hiring-banner-artwork.svg' | asset_url }}"
      class="hb-hero__artwork"
      alt=""
      loading="eager"
    >
  </div>

  <!-- Bottom -->
  <div class="hb-hero__bottom">

    <!-- Left -->
    <div class="hb-hero__content">

      <h1 class="hb-hero__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="hb-hero__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link }}"
        class="hb-btn hb-btn--black"
      >
        <span class="hb-btn__fill"></span>

        <span class="hb-btn__label">
          {{ section.settings.button_text }}
        </span>

        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          class="hb-btn__arrow"
          alt=""
        >
      </a>

    </div>

    <!-- Right -->
    <div class="hb-hero__image">

      <img
        src="{{ 'hiring-banner-artwork.svg' | asset_url }}"
        class="hb-hero__artwork-bottom"
        alt=""
        loading="eager"
      >

    </div>

  </div>

</div>

  <!-- 3. Info bar -->
  {%- if section.settings.footer_text != blank -%}
    <div class="hb-infobar">
      <p>{{ section.settings.footer_text }}</p>
    </div>
  {%- endif -%}

  <!-- Mobile slide-out menu (linked to main menu, matches hamburger in Figma) -->
  <nav id="hb-mobile-menu-{{ section.id }}" class="hb-mobile-menu" aria-hidden="true">
    <button type="button" class="hb-mobile-menu__close" aria-label="Close menu">&times;</button>
    <ul class="hb-mobile-menu__list">
      {%- for link in section.settings.mobile_menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>

</section>

{% schema %}
{
  "name": "Hiring Banner",
  "tag": "section",
  "class": "section-hiring-banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Top bar message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Top bar button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Top bar button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "artwork_image",
      "label": "Hero artwork",
      "info": "Falls back to the default illustration if left empty"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Hero button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Hero button link"
    },
    {
      "type": "header",
      "content": "Info bar"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Info bar text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile menu",
      "info": "Shown when the hamburger icon is tapped on mobile"
    }
  ],
  "presets": [
    {
      "name": "Hiring Banner"
    }
  ]
}
{% endschema %}
