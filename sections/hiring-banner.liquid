{{ 'hiring.css' | asset_url | stylesheet_tag }}
{{ 'hiring.js' | asset_url | script_tag }}

<section class="hiring-banner">

  <!-- Header -->
  <div class="banner-header page-width">

    <div class="banner-logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="banner-message">
      {{ section.settings.header_text }}
    </div>

    <a
      href="{{ section.settings.header_button_link }}"
      class="banner-header-btn"
    >
      {{ section.settings.header_button }}
    </a>

  </div>

  <!-- Hero -->
  <div class="banner-hero">

    <div class="banner-left">

      <h1>
        {{ section.settings.heading }}
      </h1>

      <div class="banner-description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link }}"
        class="banner-btn"
      >
        {{ section.settings.button_text }}
      </a>

    </div>

   <div class="banner-right">
    <img
     src="{{ 'banner-bottom.svg' | asset_url }}"
      alt="Gift Guide Artwork"
      class="banner-artwork"
      loading="lazy"
    >
</div>

  </div>

  <div class="banner-footer">

    {{ section.settings.footer_text }}

  </div>

</section>